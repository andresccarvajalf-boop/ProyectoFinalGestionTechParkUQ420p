<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uniquindio.techpark420.proyectofinalgestiontechparkuq.controller.admin.GestionZonasAtraccionesController"
            styleClass="root-pane"
            stylesheets="@../../styles/main.css">

    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="12">
            <padding>
                <Insets top="12" right="24" bottom="12" left="24"/>
            </padding>
            <Button text="← Volver" onAction="#onVolver" styleClass="ghost-button"/>
            <Label text="Zonas y Atracciones" styleClass="page-title"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="0">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <TabPane fx:id="tabPane" styleClass="tab-pane" VBox.vgrow="ALWAYS">

                <Tab text="Zonas" closable="false" fx:id="tabZonas">
                    <VBox spacing="16">
                        <padding>
                            <Insets top="20" right="0" bottom="0" left="0"/>
                        </padding>

                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <TextField fx:id="buscarZonaField" promptText="Buscar zona..." styleClass="text-field" prefWidth="260"/>
                            <Button text="Buscar" onAction="#buscarZona" styleClass="secondary-button"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="+ Nueva Zona" onAction="#handleNuevaZona" styleClass="primary-button"/>
                        </HBox>

                        <TableView fx:id="zonasTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="colZonaNombre" text="Nombre" prefWidth="220"/>
                                <TableColumn fx:id="colZonaDescripcion" text="Descripción" prefWidth="300"/>
                                <TableColumn fx:id="colZonaAtracciones" text="Nº Atracciones" prefWidth="140"/>
                                <TableColumn fx:id="colZonaOperador" text="Operador asignado" prefWidth="180"/>
                            </columns>
                        </TableView>

                        <HBox spacing="12" alignment="CENTER_RIGHT">
                            <Button fx:id="editarZonaButton" text="Editar" onAction="#handleEditarZona"
                                    styleClass="secondary-button" disable="true"/>
                            <Button fx:id="eliminarZonaButton" text="Eliminar" onAction="#handleEliminarZona"
                                    styleClass="danger-button" disable="true"/>
                        </HBox>
                    </VBox>
                </Tab>

                <Tab text="Atracciones" closable="false" fx:id="tabAtracciones">
                    <VBox spacing="16">
                        <padding>
                            <Insets top="20" right="0" bottom="0" left="0"/>
                        </padding>

                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <TextField fx:id="buscarAtraccionField" promptText="Buscar atracción..." styleClass="text-field" prefWidth="260"/>
                            <Button text="Buscar" onAction="#buscarAtraccion" styleClass="secondary-button"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="+ Nueva Atracción" onAction="#handleNuevaAtraccion" styleClass="primary-button"/>
                        </HBox>

                        <TableView fx:id="atraccionesTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="colAtraccionNombre" text="Nombre" prefWidth="180"/>
                                <TableColumn fx:id="colAtraccionZona" text="Zona" prefWidth="140"/>
                                <TableColumn fx:id="colAtraccionEstado" text="Estado" prefWidth="120"/>
                                <TableColumn fx:id="colAtraccionCapacidad" text="Capacidad" prefWidth="100"/>
                                <TableColumn fx:id="colAtraccionAltura" text="Altura mín." prefWidth="110"/>
                                <TableColumn fx:id="colAtraccionEdad" text="Edad mín." prefWidth="100"/>
                            </columns>
                        </TableView>

                        <HBox spacing="12" alignment="CENTER_RIGHT">
                            <Button fx:id="editarAtraccionButton" text="Editar" onAction="#handleEditarAtraccion"
                                    styleClass="secondary-button" disable="true"/>
                            <Button fx:id="eliminarAtraccionButton" text="Eliminar" onAction="#handleEliminarAtraccion"
                                    styleClass="danger-button" disable="true"/>
                        </HBox>
                    </VBox>
                </Tab>

            </TabPane>
        </VBox>
    </center>
</BorderPane>
