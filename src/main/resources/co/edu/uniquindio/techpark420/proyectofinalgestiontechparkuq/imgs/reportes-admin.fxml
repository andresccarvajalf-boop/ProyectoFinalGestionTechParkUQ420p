<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uniquindio.techpark420.proyectofinalgestiontechparkuq.controller.admin.ReportesController"
            styleClass="root-pane"
            stylesheets="@../../styles/main.css">

    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="12">
            <padding>
                <Insets top="12" right="24" bottom="12" left="24"/>
            </padding>
            <Button text="← Volver" onAction="#onVolverDashboard" styleClass="ghost-button"/>
            <Label text="Reportes" styleClass="page-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Exportar" onAction="#handleExportar" styleClass="secondary-button"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="16">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <!-- fx:id="tabPane" coincide con @FXML private TabPane tabPane -->
            <TabPane fx:id="tabPane" styleClass="tab-pane" VBox.vgrow="ALWAYS">

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- Tab 1 – Ingresos                                          -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <Tab text="Ingresos" closable="false">
                    <VBox spacing="16">
                        <padding><Insets top="20" right="0" bottom="0" left="0"/></padding>

                        <HBox spacing="16">
                            <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                                <Label text="Ingresos totales" styleClass="card-title"/>
                                <!-- fx:id="ingresosTotalesLabel" -->
                                <Label fx:id="ingresosTotalesLabel" styleClass="card-value"/>
                            </VBox>
                            <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                                <Label text="Tickets vendidos" styleClass="card-title"/>
                                <!-- fx:id="ticketsVendidosLabel" -->
                                <Label fx:id="ticketsVendidosLabel" styleClass="card-value"/>
                            </VBox>
                            <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                                <Label text="Ticket más vendido" styleClass="card-title"/>
                                <!-- fx:id="ticketMasVendidoLabel" -->
                                <Label fx:id="ticketMasVendidoLabel" styleClass="card-value"/>
                            </VBox>
                        </HBox>

                        <!-- fx:id="ingresosTable" -->
                        <TableView fx:id="ingresosTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="colIngFecha"      text="Fecha"           prefWidth="160"/>
                                <TableColumn fx:id="colIngTipoTicket" text="Tipo de ticket"  prefWidth="160"/>
                                <TableColumn fx:id="colIngVisitante"  text="Visitante"        prefWidth="200"/>
                                <TableColumn fx:id="colIngMonto"      text="Monto"            prefWidth="120"/>
                            </columns>
                        </TableView>

                        <HBox alignment="CENTER_RIGHT">
                            <Button text="Generar reporte de ingresos"
                                    onAction="#handleGenerarReporteIngresos"
                                    styleClass="primary-button"/>
                        </HBox>
                    </VBox>
                </Tab>

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- Tab 2 – Atracciones más visitadas                         -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <Tab text="Atracciones más visitadas" closable="false">
                    <VBox spacing="16">
                        <padding><Insets top="20" right="0" bottom="0" left="0"/></padding>

                        <HBox spacing="16">
                            <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                                <Label text="Atracción #1" styleClass="card-title"/>
                                <!-- fx:id="topAtraccionLabel" -->
                                <Label fx:id="topAtraccionLabel" styleClass="card-value"/>
                            </VBox>
                            <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                                <Label text="Total visitantes registrados" styleClass="card-title"/>
                                <!-- fx:id="totalIngresosAtraccionesLabel" -->
                                <Label fx:id="totalIngresosAtraccionesLabel" styleClass="card-value"/>
                            </VBox>
                        </HBox>

                        <!-- fx:id="atraccionesVisitadasTable" -->
                        <TableView fx:id="atraccionesVisitadasTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="colAvRanking"     text="#"               prefWidth="50"/>
                                <TableColumn fx:id="colAvNombre"      text="Atracción"        prefWidth="200"/>
                                <TableColumn fx:id="colAvZona"        text="Zona"             prefWidth="160"/>
                                <TableColumn fx:id="colAvVisitantes"  text="Total visitantes" prefWidth="150"/>
                                <TableColumn fx:id="colAvPromedioDia" text="Promedio / día"   prefWidth="130"/>
                            </columns>
                        </TableView>

                        <HBox alignment="CENTER_RIGHT">
                            <Button text="Generar reporte de atracciones"
                                    onAction="#handleGenerarReporteAtracciones"
                                    styleClass="primary-button"/>
                        </HBox>
                    </VBox>
                </Tab>

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- Tab 3 – Mantenimientos                                    -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <Tab text="Mantenimientos" closable="false">
                    <VBox spacing="16">
                        <padding><Insets top="20" right="0" bottom="0" left="0"/></padding>

                        <HBox spacing="16">
                            <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                                <Label text="Revisiones totales" styleClass="card-title"/>
                                <!-- fx:id="revisionesTotalesLabel" -->
                                <Label fx:id="revisionesTotalesLabel" styleClass="card-value"/>
                            </VBox>
                            <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                                <Label text="Atracción con más mantenimientos" styleClass="card-title"/>
                                <!-- fx:id="atraccionMasMantenimientoLabel" -->
                                <Label fx:id="atraccionMasMantenimientoLabel" styleClass="card-value"/>
                            </VBox>
                        </HBox>

                        <!-- fx:id="mantenimientosTable" — ahora TableView<Revision> -->
                        <TableView fx:id="mantenimientosTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="colMantFecha"       text="Fecha"       prefWidth="160"/>
                                <TableColumn fx:id="colMantAtraccion"   text="Atracción"   prefWidth="180"/>
                                <TableColumn fx:id="colMantOperador"    text="Operador"    prefWidth="180"/>
                                <TableColumn fx:id="colMantDescripcion" text="Descripción" prefWidth="260"/>
                                <TableColumn fx:id="colMantResultado"   text="Resultado"   prefWidth="130"/>
                            </columns>
                        </TableView>

                        <HBox alignment="CENTER_RIGHT">
                            <Button text="Generar reporte de mantenimientos"
                                    onAction="#handleGenerarReporteMantenimientos"
                                    styleClass="primary-button"/>
                        </HBox>
                    </VBox>
                </Tab>

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- Tab 4 – Cierres por Clima                                 -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <Tab text="Cierres por Clima" closable="false">
                    <VBox spacing="16">
                        <padding><Insets top="20" right="0" bottom="0" left="0"/></padding>

                        <HBox spacing="16">
                            <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                                <Label text="Total cierres por clima" styleClass="card-title"/>
                                <!-- fx:id="totalCierresLabel" -->
                                <Label fx:id="totalCierresLabel" styleClass="card-value"/>
                            </VBox>
                            <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                                <Label text="Atracción más afectada" styleClass="card-title"/>
                                <!-- fx:id="atraccionMasAfectadaLabel" -->
                                <Label fx:id="atraccionMasAfectadaLabel" styleClass="card-value"/>
                            </VBox>
                            <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                                <Label text="Tipo de alerta más frecuente" styleClass="card-title"/>
                                <!-- fx:id="tipoAlertaFrecuenteLabel" -->
                                <Label fx:id="tipoAlertaFrecuenteLabel" styleClass="card-value"/>
                            </VBox>
                        </HBox>

                        <!-- fx:id="cierresClimaTable" -->
                        <TableView fx:id="cierresClimaTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="colCcFecha"      text="Fecha"          prefWidth="160"/>
                                <TableColumn fx:id="colCcAtraccion"  text="Atracción(es)"  prefWidth="180"/>
                                <TableColumn fx:id="colCcTipoAlerta" text="Tipo de alerta" prefWidth="160"/>
                                <TableColumn fx:id="colCcDuracion"   text="Duración (h)"   prefWidth="120"/>
                            </columns>
                        </TableView>

                        <HBox alignment="CENTER_RIGHT">
                            <Button text="Generar reporte de cierres"
                                    onAction="#handleGenerarReporteCierres"
                                    styleClass="primary-button"/>
                        </HBox>
                    </VBox>
                </Tab>

            </TabPane>
        </VBox>
    </center>
</BorderPane>
