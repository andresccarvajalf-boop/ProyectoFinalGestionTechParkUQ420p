<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uniquindio.techpark420.proyectofinalgestiontechparkuq.controller.visitante.NotificacionesController"
            style="-fx-background-color: #f0f4f8;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: #1a1a2e; -fx-padding: 12 24 12 24;">
            <Button text="← Volver" onAction="#onVolver"
                    style="-fx-cursor: hand; -fx-text-fill: white;
                           -fx-background-color: transparent;"/>
            <Label text="🔔 Mis Notificaciones"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblNoLeidas"
                   style="-fx-text-fill: #f0f0f0; -fx-font-size: 13px;"/>
            <Button text="Marcar todas leídas" onAction="#onMarcarTodas"
                    style="-fx-cursor: hand;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="16" style="-fx-padding: 24;">

            <!-- Filtros -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Filtrar:"
                       style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                <Button text="Todas" onAction="#onMostrarTodas"
                        style="-fx-cursor: hand;"/>
                <Button text="No leídas" onAction="#onFiltrarNoLeidas"
                        style="-fx-cursor: hand;"/>
            </HBox>

            <!-- Tabla -->
            <TableView fx:id="tablaNotificaciones" VBox.vgrow="ALWAYS" prefHeight="400">
                <columns>
                    <TableColumn fx:id="colTitulo"    text="Título"   prefWidth="150"/>
                    <TableColumn fx:id="colMensaje"   text="Mensaje"  prefWidth="250"/>
                    <TableColumn fx:id="colFecha"     text="Fecha"    prefWidth="130"/>
                    <TableColumn fx:id="colEstado"    text="Estado"   prefWidth="80"/>
                </columns>
            </TableView>

            <!-- Botón marcar seleccionada -->
            <HBox alignment="CENTER_RIGHT">
                <Button fx:id="btnMarcarLeida"
                        text="✅ Marcar como leída"
                        onAction="#onMarcarLeida"
                        style="-fx-background-color: #2980b9; -fx-text-fill: white;
                               -fx-pref-height: 36px; -fx-background-radius: 6;
                               -fx-cursor: hand;"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>