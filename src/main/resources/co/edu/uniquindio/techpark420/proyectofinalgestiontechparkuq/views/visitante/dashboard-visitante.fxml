<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uniquindio.techpark420.proyectofinalgestiontechparkuq.controller.visitante.DashboardVisitanteController"
            style="-fx-background-color: #f0f4f8;">

    <!-- ── TOP BAR ──────────────────────────────────────────────────────── -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: #1a1a2e; -fx-padding: 12 24 12 24;">
            <Label text="🎢 Tech-Park UQ"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="saldoLabel"
                   style="-fx-text-fill: #f0f0f0; -fx-font-size: 13px;"/>
            <Button text="🔔" onAction="#irANotificaciones"
                    style="-fx-cursor: hand;"/>
            <Button text="Cerrar sesión" onAction="#cerrarSesion"
                    style="-fx-cursor: hand;"/>
        </HBox>
    </top>

    <!-- ── MENÚ LATERAL ─────────────────────────────────────────────────── -->
    <left>
        <VBox spacing="8" minWidth="190"
              style="-fx-background-color: #ffffff; -fx-padding: 24 16 24 16;
                     -fx-border-color: #ddd; -fx-border-width: 0 1 0 0;"
              alignment="TOP_CENTER">

            <!-- Foto de perfil circular -->
            <VBox alignment="CENTER" spacing="6">
                <ImageView fx:id="imgPerfil"
                           fitWidth="72" fitHeight="72"
                           preserveRatio="false"
                           style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 8, 0, 0, 2);">
                    <clip>
                        <Circle centerX="36" centerY="36" radius="36"/>
                    </clip>
                </ImageView>
                <Button text="📷 Cambiar foto" onAction="#subirFoto"
                        style="-fx-font-size: 11px; -fx-cursor: hand;
                               -fx-background-color: transparent;
                               -fx-text-fill: #2980b9;
                               -fx-underline: true;
                               -fx-padding: 0;"/>
            </VBox>

            <!-- Separador visual -->
            <Region prefHeight="8"/>
            <Label text="Menú"
                   style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #888;"/>

            <!-- Botones de navegación -->
            <Button text="🏠 Inicio" onAction="#irAInicio"
                    maxWidth="Infinity" style="-fx-cursor: hand;"/>
            <Button text="🎟 Comprar Ticket" onAction="#irACompraTicket"
                    maxWidth="Infinity" style="-fx-cursor: hand;"/>
            <Button text="💰 Recargar Saldo" onAction="#irARecargarSaldo"
                    maxWidth="Infinity" style="-fx-cursor: hand;"/>
            <Button text="🔔 Notificaciones" onAction="#irANotificaciones"
                    maxWidth="Infinity" style="-fx-cursor: hand;"/>
        </VBox>
    </left>

    <!-- ── CONTENIDO CENTRAL ─────────────────────────────────────────────── -->
    <center>
        <VBox spacing="24" style="-fx-padding: 24;">

            <!-- Tarjetas de resumen -->
            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-padding: 16;
                             -fx-border-color: #ddd; -fx-border-radius: 8;
                             -fx-background-radius: 8;">
                    <Label text="Bienvenido"
                           style="-fx-text-fill: #777; -fx-font-size: 12px;"/>
                    <Label fx:id="nombreVisitanteLabel"
                           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox spacing="6" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-padding: 16;
                             -fx-border-color: #ddd; -fx-border-radius: 8;
                             -fx-background-radius: 8;">
                    <Label text="Saldo Virtual"
                           style="-fx-text-fill: #777; -fx-font-size: 12px;"/>
                    <Label fx:id="saldoCardLabel"
                           style="-fx-font-size: 16px; -fx-font-weight: bold;
                                  -fx-text-fill: #27ae60;"/>
                </VBox>

                <VBox spacing="6" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-padding: 16;
                             -fx-border-color: #ddd; -fx-border-radius: 8;
                             -fx-background-radius: 8;">
                    <Label text="Notificaciones sin leer"
                           style="-fx-text-fill: #777; -fx-font-size: 12px;"/>
                    <Label fx:id="notifBadgeLabel"
                           style="-fx-font-size: 16px; -fx-font-weight: bold;
                                  -fx-text-fill: #e74c3c;"/>
                </VBox>
            </HBox>

            <!-- Mapa y favoritas -->
            <HBox spacing="16" VBox.vgrow="ALWAYS">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Zonas y Atracciones"
                           style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <TreeView fx:id="mapaTreeView" VBox.vgrow="ALWAYS"
                              onMouseClicked="#handleAtraccionSeleccionada"
                              prefHeight="350"/>
                </VBox>

                <VBox spacing="8" minWidth="220">
                    <Label text="Mis Favoritas"
                           style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <ListView fx:id="favoritasListView" prefHeight="300"/>
                    <Button text="Ver detalle" onAction="#verDetalleAtraccion"
                            maxWidth="Infinity"
                            style="-fx-background-color: #2980b9; -fx-text-fill: white;
                                   -fx-cursor: hand; -fx-background-radius: 6;"/>
                </VBox>
            </HBox>

        </VBox>
    </center>

</BorderPane>
