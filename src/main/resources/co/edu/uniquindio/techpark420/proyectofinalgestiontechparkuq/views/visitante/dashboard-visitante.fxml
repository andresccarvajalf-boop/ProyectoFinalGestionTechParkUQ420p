<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uniquindio.techpark420.proyectofinalgestiontechparkuq.controller.visitante.DashboardVisitanteController"
            style="-fx-background-color: #1a1a2e;">

    <!-- ── TOP BAR ──────────────────────────────────────────────────────── -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: #0f0f1a; -fx-padding: 12 24 12 24;">
            <Label text="🎢 Tech-Park UQ"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="saldoLabel"
                   style="-fx-text-fill: #f0f0f0; -fx-font-size: 13px;"/>
            <Button text="🔔" onAction="#irANotificaciones"
                    style="-fx-cursor: hand; -fx-background-color: transparent;
                           -fx-text-fill: white; -fx-font-size: 16px;"/>
            <Button text="Cerrar sesión" onAction="#cerrarSesion"
                    style="-fx-cursor: hand;"/>
        </HBox>
    </top>

    <!-- ── MENÚ LATERAL ─────────────────────────────────────────────────── -->
    <left>
        <VBox spacing="8" minWidth="190"
              style="-fx-background-color: #12122a; -fx-padding: 24 16 24 16;
                     -fx-border-color: rgba(255,255,255,0.1); -fx-border-width: 0 1 0 0;"
              alignment="TOP_CENTER">

            <!-- Foto de perfil circular -->
            <VBox alignment="CENTER" spacing="6">
                <ImageView fx:id="imgPerfil"
                           fitWidth="72" fitHeight="72"
                           preserveRatio="false"
                           style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45), 10, 0, 0, 3);">
                    <clip>
                        <Circle centerX="36" centerY="36" radius="36"/>
                    </clip>
                </ImageView>
                <Button text="📷 Cambiar foto" onAction="#subirFoto"
                        style="-fx-font-size: 11px; -fx-cursor: hand;
                               -fx-background-color: transparent;
                               -fx-text-fill: #5dade2;
                               -fx-underline: true;
                               -fx-padding: 0;"/>
            </VBox>

            <!-- Nombre del visitante -->
            <Label fx:id="nombreVisitanteLabel"
                   style="-fx-font-size: 13px; -fx-font-weight: bold;
                          -fx-text-fill: white; -fx-wrap-text: true;"
                   maxWidth="158" wrapText="true"/>

            <!-- Separador visual -->
            <Region prefHeight="8"/>
            <Label text="MENÚ"
                   style="-fx-font-weight: bold; -fx-font-size: 10px;
                          -fx-text-fill: rgba(255,255,255,0.4); -fx-letter-spacing: 1px;"/>

            <!-- Botones de navegación -->
            <Button text="🏠  Inicio" onAction="#irAInicio"
                    maxWidth="Infinity"
                    style="-fx-cursor: hand; -fx-background-color: transparent;
                           -fx-text-fill: white; -fx-alignment: CENTER_LEFT;"/>
            <Button text="🎟  Comprar Ticket" onAction="#irACompraTicket"
                    maxWidth="Infinity"
                    style="-fx-cursor: hand; -fx-background-color: transparent;
                           -fx-text-fill: white; -fx-alignment: CENTER_LEFT;"/>
            <Button text="💰  Recargar Saldo" onAction="#irARecargarSaldo"
                    maxWidth="Infinity"
                    style="-fx-cursor: hand; -fx-background-color: transparent;
                           -fx-text-fill: white; -fx-alignment: CENTER_LEFT;"/>
            <Button text="🔔  Notificaciones" onAction="#irANotificaciones"
                    maxWidth="Infinity"
                    style="-fx-cursor: hand; -fx-background-color: transparent;
                           -fx-text-fill: white; -fx-alignment: CENTER_LEFT;"/>
        </VBox>
    </left>

    <!-- ── CONTENIDO CENTRAL ─────────────────────────────────────────────── -->
    <center>
        <VBox spacing="20" style="-fx-padding: 20;">

            <!-- Tarjetas de resumen -->
            <HBox spacing="14">

                <!-- Tarjeta: Bienvenida (nombreVisitanteLabel ya está en el sidebar;
                     aquí usamos saldoCardLabel y notifBadgeLabel como en el controlador) -->
                <VBox spacing="6" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: rgba(255,255,255,0.06);
                             -fx-padding: 14; -fx-border-color: rgba(255,255,255,0.12);
                             -fx-border-radius: 10; -fx-background-radius: 10;">
                    <Label text="Saldo Virtual"
                           style="-fx-text-fill: rgba(255,255,255,0.55); -fx-font-size: 12px;"/>
                    <Label fx:id="saldoCardLabel"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;
                                  -fx-text-fill: #2ecc71;"/>
                </VBox>

                <VBox spacing="6" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: rgba(255,255,255,0.06);
                             -fx-padding: 14; -fx-border-color: rgba(255,255,255,0.12);
                             -fx-border-radius: 10; -fx-background-radius: 10;">
                    <Label text="Notificaciones sin leer"
                           style="-fx-text-fill: rgba(255,255,255,0.55); -fx-font-size: 12px;"/>
                    <Label fx:id="notifBadgeLabel"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;
                                  -fx-text-fill: #e74c3c;"/>
                </VBox>

            </HBox>

            <!-- Título de sección -->
            <Label text="Zonas y Atracciones"
                   style="-fx-font-weight: bold; -fx-font-size: 15px;
                          -fx-text-fill: white;"/>

            <!-- Mapa visual con FlowPane dentro de ScrollPane -->
            <ScrollPane fx:id="mapaScrollPane"
                        fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent;
                               -fx-background: transparent;
                               -fx-border-color: transparent;">
                <FlowPane fx:id="mapaFlowPane"
                          hgap="14" vgap="14"
                          style="-fx-background-color: transparent; -fx-padding: 4;">
                    <padding><Insets top="4" right="4" bottom="4" left="4"/></padding>
                </FlowPane>
            </ScrollPane>

        </VBox>
    </center>

</BorderPane>