<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uniquindio.techpark420.proyectofinalgestiontechparkuq.controller.operador.DashboardOperadorController"
            styleClass="root-pane"
            stylesheets="@../../styles/main.css">

    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="16">
            <padding>
                <Insets top="12" right="24" bottom="12" left="24"/>
            </padding>
            <Label text="Tech-Park UQ — Operador" styleClass="brand-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="nombreOperadorLabel" styleClass="info-text"/>
            <Label text="|" styleClass="info-text"/>
            <Label text="Zona:" styleClass="field-label"/>
            <Label fx:id="zonaAsignadaLabel" styleClass="saldo-label"/>
            <Button text="Cerrar sesión" onAction="#cerrarSesion" styleClass="ghost-button"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="24">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <HBox spacing="16">
                <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="Atracciones en tu zona" styleClass="card-title"/>
                    <Label fx:id="totalAtraccionesLabel" styleClass="card-value"/>
                </VBox>
                <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="Abiertas ahora" styleClass="card-title"/>
                    <Label fx:id="abieratasLabel" styleClass="card-value"/>
                </VBox>
                <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="En mantenimiento" styleClass="card-title"/>
                    <Label fx:id="mantenimientoLabel" styleClass="card-value"/>
                </VBox>
                <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="Visitantes acumulados hoy" styleClass="card-title"/>
                    <Label fx:id="visitantesAcumuladosLabel" styleClass="card-value"/>
                </VBox>
            </HBox>

            <Label text="Atracciones de tu zona" styleClass="section-title"/>

            <TableView fx:id="atraccionesTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="130"/>
                    <TableColumn fx:id="colCola" text="En cola" prefWidth="100"/>
                    <TableColumn fx:id="colTiempoEspera" text="Tiempo espera" prefWidth="140"/>
                    <TableColumn fx:id="colVisitantesHoy" text="Visitantes hoy" prefWidth="130"/>
                </columns>
            </TableView>

            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button fx:id="gestionarButton" text="Gestionar Atracción" onAction="#irAGestionAtraccion"
                        styleClass="primary-button" disable="true"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
