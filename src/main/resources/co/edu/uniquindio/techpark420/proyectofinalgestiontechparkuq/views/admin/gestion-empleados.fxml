<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uniquindio.techpark420.proyectofinalgestiontechparkuq.controller.admin.GestionEmpleadosController"
            styleClass="root-pane"
            stylesheets="@../../styles/main.css">

    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="12">
            <padding>
                <Insets top="12" right="24" bottom="12" left="24"/>
            </padding>
            <Button text="← Volver" onAction="#onVolver" styleClass="ghost-button"/>
            <Label text="Gestión de Empleados" styleClass="page-title"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="16">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <HBox spacing="16">
                <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="Total empleados" styleClass="card-title"/>
                    <Label fx:id="totalEmpleadosLabel" styleClass="card-value"/>
                </VBox>
                <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="Operadores" styleClass="card-title"/>
                    <Label fx:id="totalOperadoresLabel" styleClass="card-value"/>
                </VBox>
                <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="Administradores" styleClass="card-title"/>
                    <Label fx:id="totalAdminsLabel" styleClass="card-value"/>
                </VBox>
            </HBox>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <TextField fx:id="buscarField" promptText="Buscar por nombre o documento..."
                           styleClass="text-field" prefWidth="280"/>
                <Button text="Buscar" onAction="#buscarEmpleado" styleClass="secondary-button"/>
                <Label text="Filtrar por rol:" styleClass="field-label"/>
                <ChoiceBox fx:id="filtroRolChoice" styleClass="choice-box" prefWidth="160"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="+ Contratar Empleado" onAction="#handleContratarEmpleado" styleClass="primary-button"/>
            </HBox>

            <TableView fx:id="empleadosTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colDocumento" text="Documento" prefWidth="130"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200"/>
                    <TableColumn fx:id="colRol" text="Rol" prefWidth="120"/>
                    <TableColumn fx:id="colZonaAsignada" text="Zona asignada" prefWidth="180"/>
                    <TableColumn fx:id="colCorreo" text="Correo" prefWidth="220"/>
                    <TableColumn fx:id="colEstadoEmpleado" text="Estado" prefWidth="100"/>
                </columns>
            </TableView>

            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Label fx:id="mensajeLabel" styleClass="info-text" visible="false" managed="false"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="editarButton" text="Editar" onAction="#handleEditarEmpleado"
                        styleClass="secondary-button" disable="true"/>
                <Button fx:id="asignarZonaButton" text="Asignar Zona" onAction="#handleAsignarZona"
                        styleClass="secondary-button" disable="true"/>
                <Button fx:id="desvincularButton" text="Desvincular" onAction="#handleDesvincularEmpleado"
                        styleClass="danger-button" disable="true"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
