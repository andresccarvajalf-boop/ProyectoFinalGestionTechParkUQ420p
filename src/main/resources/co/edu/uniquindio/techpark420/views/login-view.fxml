<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane
    xmlns="http://javafx.com/javafx"
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="co.edu.uniquindio.techpark420.proyectofinalgestiontechparkuq.controller.auth.LoginController"
    style="-fx-background-color: #f0f4f8;">

    <VBox alignment="CENTER" spacing="20" maxWidth="380">
        <padding>
            <Insets top="48" right="40" bottom="48" left="40"/>
        </padding>

        <!-- Título -->
        <Label text="🎢 Tech-Park UQ"
               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
        <Label text="Sistema de Gestión del Parque"
               style="-fx-font-size: 13px; -fx-text-fill: #555;"/>

        <!-- Separador visual -->
        <VBox style="-fx-border-color: #ddd; -fx-border-width: 0 0 1 0;" prefHeight="1"/>

        <!-- Campo documento (fx:id debe coincidir EXACTAMENTE con LoginController) -->
        <VBox spacing="6">
            <Label text="Número de documento"
                   style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
            <TextField fx:id="txtDocumento"
                       promptText="Ej: 1000000001"
                       style="-fx-font-size: 14px; -fx-pref-height: 38px;"/>
        </VBox>

        <!-- Mensaje de error -->
        <Label fx:id="lblError"
               text=""
               style="-fx-text-fill: #c0392b; -fx-font-size: 12px;"
               visible="false"
               managed="false"
               wrapText="true"/>

        <!-- Botón ingresar -->
        <Button text="Ingresar"
                onAction="#onIniciarSesion"
                maxWidth="Infinity"
                style="-fx-background-color: #2980b9; -fx-text-fill: white;
                       -fx-font-size: 14px; -fx-pref-height: 40px;
                       -fx-cursor: hand; -fx-background-radius: 6;"/>

        <!-- Separador -->
        <Label text="¿No tienes cuenta?"
               style="-fx-text-fill: #777; -fx-font-size: 12px;"/>

        <!-- Botón mostrar registro -->
        <Button text="Registrarse como Visitante"
                onAction="#onMostrarRegistro"
                maxWidth="Infinity"
                style="-fx-background-color: transparent; -fx-text-fill: #2980b9;
                       -fx-font-size: 13px; -fx-cursor: hand;
                       -fx-border-color: #2980b9; -fx-border-radius: 6;
                       -fx-background-radius: 6; -fx-pref-height: 36px;"/>

        <!-- Panel de registro (oculto por defecto) -->
        <VBox fx:id="panelRegistro" spacing="10" visible="false" managed="false"
              style="-fx-background-color: #eaf4fb; -fx-padding: 14;
                     -fx-background-radius: 8; -fx-border-color: #aed6f1;
                     -fx-border-radius: 8; -fx-border-width: 1;">

            <Label text="Nuevo Visitante"
                   style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

            <TextField fx:id="txtNombre"         promptText="Nombre completo"/>
            <TextField fx:id="txtDocumentoRegistro" promptText="Número de documento"/>

            <HBox spacing="10">
                <TextField fx:id="txtEdad"     promptText="Edad"     HBox.hgrow="ALWAYS"/>
                <TextField fx:id="txtEstatura" promptText="Estatura (ej: 1.75)" HBox.hgrow="ALWAYS"/>
            </HBox>

            <Button text="Crear cuenta"
                    onAction="#onRegistrarVisitante"
                    maxWidth="Infinity"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white;
                           -fx-pref-height: 36px; -fx-background-radius: 6;
                           -fx-cursor: hand;"/>
        </VBox>

        <!-- Usuarios demo -->
        <Label text="Demo → Admin: 1000000001 | Operador: 1000000002 | Visitante: 1000000003"
               style="-fx-text-fill: #999; -fx-font-size: 10px;"
               wrapText="true"/>

    </VBox>
</StackPane>